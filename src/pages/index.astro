  <!-- B2B FORM WITH ROSSO IDENTITA SUBMIT BUTTON -->
  <section
    class="border-b border-[#E5E5E8] bg-[#121314] text-[#F8F8FA]"
    id="alokacia"
  >
    <div class="mx-auto max-w-[1440px] px-5 py-16 sm:px-6 md:px-16 md:py-20">
      <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="space-y-6 lg:col-span-5">
          <span class="block font-headline text-[10px] font-semibold tracking-[0.2em] uppercase text-[#F03E45]">
            ZÍSKAJTE VEĽKOOBCHODNÝ CENNÍK
          </span>
          <h2 class="font-headline text-2xl leading-[1.2] font-bold tracking-tight uppercase text-[#F8F8FA] sm:text-4xl sm:leading-[1.18]">
            Vyžiadajte si veľkoobchodný cenník
          </h2>
          <p class="font-body text-sm leading-relaxed text-[#A0A2A6]">
            Zadajte parametre vašej gastro prevádzky alebo dopytované suroviny.
            Náš obchodný zástupca vás bude obratom kontaktovať s oficiálnym
            veľkoobchodným cenníkom a podmienkami pravidelných závozov.
          </p>

          <div class="grid grid-cols-1 gap-4 border-t border-[#252629] pt-6 sm:grid-cols-2 lg:grid-cols-1">
            <div>
              <span class="block font-headline text-[10px] tracking-widest uppercase text-[#8E9094]">
                E-MAIL
              </span>
              <a
                class="mt-1 block font-headline text-sm font-medium text-[#F8F8FA] transition-colors hover:text-[#F03E45]"
                href={`mailto:${siteConfig.email}`}
              >
                {siteConfig.email}
              </a>
            </div>
            <div>
              <span class="block font-headline text-[10px] tracking-widest uppercase text-[#8E9094]">
                TELEFÓN
              </span>
              <a
                href={`tel:${siteConfig.phone}`}
                class="mt-1 block font-mono text-sm font-medium text-[#F8F8FA] no-underline transition-colors hover:text-[#F03E45]"
              >
                {siteConfig.phoneDisplay}
              </a>
            </div>
            <div>
              <span class="block font-headline text-[10px] tracking-widest uppercase text-[#8E9094]">
                ADRESA A SÍDLO
              </span>
              <span class="mt-1 block font-headline text-sm font-medium text-[#F8F8FA]">
                {siteConfig.street}, {siteConfig.zip} {siteConfig.city}
              </span>
            </div>
            <div>
              <span class="block font-headline text-[10px] tracking-widest uppercase text-[#8E9094]">
                IČO
              </span>
              <span class="mt-1 block font-mono text-sm font-medium text-[#F8F8FA]">
                {siteConfig.ico}
              </span>
            </div>
          </div>
        </div>

        <div class="border border-[#252629] bg-[#17181A] p-6 sm:p-8 md:p-10 lg:col-span-7">
          <form class="space-y-6" action="#alokacia" method="get">
            <div class="space-y-6">
              <div>
                <label
                  for="inquiry-name-company"
                  class="mb-2 block font-headline text-[11px] font-bold tracking-widest uppercase text-[#C5C6C9]"
                >
                  MENO A NÁZOV PREVÁDZKY *
                </label>
                <input
                  id="inquiry-name-company"
                  name="nameCompany"
                  class="w-full border border-[#313338] bg-[#1F2022] px-4 py-3.5 text-base text-[#F8F8FA] placeholder-[#8E9094] focus:border-[#D2232A] focus:outline-none sm:text-sm"
                  placeholder="napr. Tomáš Horváth, Pizzeria Napoli"
                  required
                  type="text"
                />
              </div>

              <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div>
                  <label
                    for="inquiry-email"
                    class="mb-2 block font-headline text-[11px] font-bold tracking-widest uppercase text-[#C5C6C9]"
                  >
                    E-MAILOVÁ ADRESA *
                  </label>
                  <input
                    id="inquiry-email"
                    name="email"
                    class="w-full border border-[#313338] bg-[#1F2022] px-4 py-3.5 text-base text-[#F8F8FA] placeholder-[#8E9094] focus:border-[#D2232A] focus:outline-none sm:text-sm"
                    placeholder="vasa@prevadzka.sk"
                    required
                    type="email"
                  />
                </div>
                <div>
                  <label
                    for="inquiry-phone"
                    class="mb-2 block font-headline text-[11px] font-bold tracking-widest uppercase text-[#C5C6C9]"
                  >
                    TELEFÓNNE ČÍSLO *
                  </label>
                  <input
                    id="inquiry-phone"
                    name="phone"
                    class="w-full border border-[#313338] bg-[#1F2022] px-4 py-3.5 text-base text-[#F8F8FA] placeholder-[#8E9094] focus:border-[#D2232A] focus:outline-none sm:text-sm"
                    placeholder="+421 900 000 000"
                    required
                    type="tel"
                  />
                </div>
              </div>

              <div>
                <label
                  for="inquiry-message"
                  class="mb-2 block font-headline text-[11px] font-bold tracking-widest uppercase text-[#C5C6C9]"
                >
                  DOPYTOVANÉ SUROVINY ALEBO SPRÁVA
                </label>
                <textarea
                  id="inquiry-message"
                  name="message"
                  class="min-h-[90px] w-full resize-y border border-[#313338] bg-[#1F2022] px-4 py-3 text-base text-[#F8F8FA] placeholder-[#8E9094] focus:border-[#D2232A] focus:outline-none sm:text-sm"
                  placeholder="napr. Múka Le 5 Stagioni (25 kg), Mozzarella Valcolatte, krevety Galana..."
                  rows="3"
                ></textarea>
              </div>

              <div class="space-y-4 border-t border-[#252629] pt-2">
                <p class="font-body text-xs leading-relaxed text-[#8E9094]">
                  Odoslaním formulára beriete na vedomie spracovanie osobných
                  údajov na účel vybavenia B2B dopytu v súlade s platnou
                  legislatívou.
                </p>
                <button
                  class="flex w-full items-center justify-center gap-2 bg-[#D2232A] px-6 py-4 text-center font-headline text-xs font-bold tracking-[0.08em] uppercase text-[#FFFFFF] transition-all hover:bg-[#b51d23] active:translate-y-[1px]"
                  type="submit"
                >
                  ODOSLAŤ NEZÁVÄZNÝ DOPYT →
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
