---
interface Props {
  targetId?: string;
  label?: string;
}

const { targetId = 'main-content', label = 'Preskočiť na hlavný obsah' } =
  Astro.props;
---

<a
  href={`#${targetId}`}
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-tomato focus:px-4 focus:py-3 focus:font-semibold focus:text-white focus:shadow-lg focus:ring-2 focus:ring-white focus:outline-none"
>
  {label}
</a>
