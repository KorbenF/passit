# Environment variables for local development (wrangler dev)
# Copy this file to .dev.vars and fill in your development keys.
# NEVER commit .dev.vars to git!

# Application environment (development | staging | production)
APP_ENV=development

# CSP enforcement mode (report-only | enforce)
CSP_MODE=report-only

# Cloudflare Turnstile secret key (testing dummy key for dev)
# Always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend API Key (EU region, used in Phase 7)
RESEND_API_KEY=re_placeholder_development_only

# Destination email for inquiries
INQUIRY_RECIPIENT_EMAIL=dopyt@passit.sk
